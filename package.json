{
  "name": "e-pocket",
  "version": "1.0.0",
  "private": true,
  "description": "E-Pocket — ระบบจัดการการเงินส่วนบุคคลและคำนวณรายรับ-รายจ่ายรายเดือนภายใต้ Monolith Hub",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "build:packages": "npm run build --workspace=@monolith/auth-client",
    "predev": "npm run generate && npm run build:packages",
    "dev": "next dev -p 3001",
    "prebuild": "npm run generate && npm run build:packages",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "npm run generate && npm run build:packages && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --env-file=.env --env-file-if-exists=.env.local --import tsx --test tests/*.test.ts",
    "db:push": "node --env-file=.env node_modules/prisma/build/index.js db push --schema=prisma/schema.prisma",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "cf:build": "npm run generate && npm run build:packages && opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@monolith/auth-client": "*",
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.0.0",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
