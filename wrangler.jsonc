{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "e-pocket",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "APP_ENV": "production"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
